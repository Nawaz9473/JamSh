datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserProfile {
  id              String        @id @default(uuid())
  username        String        @unique
  displayName     String?
  avatarUrl       String?
  coverUrl        String?
  bio             String?
  website         String?
  followersCount  Int           @default(0)
  followingCount  Int           @default(0)
  isPrivate       Boolean       @default(false)
  isVerified      Boolean       @default(false)
  birthday        DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  posts           Post[]
  comments        Comment[]
  followers       FollowRelation[]  @relation("following")
  following       FollowRelation[]  @relation("follower")
  chatMembers     ChatMember[]
  messages        Message[]
  deviceKeys      DeviceKey[]
  liveStreams     LiveStream[]
  liveComments    LiveComment[]
  reportsMade     Report[]          @relation("reporter")
  reportsReceived Report[]          @relation("reportedUser")
  communities     Community[]       @relation("communityCreator")
  communityMember CommunityMember[]
  channels        CreatorChannel[]
  searchHistory   SearchHistory[]
  userInterests   UserInterest[]
  shares          Share[]
  saves           Save[]
  notificationsRcvd Notification[] @relation("notification_recipient")
  notificationsSent Notification[] @relation("notification_sender")
  notificationPreferences NotificationPreferences?
  blockedUsers    UserBlock[]    @relation("blocker")
  blockedBy       UserBlock[]    @relation("blocked")
}

model Post {
  id            String        @id @default(uuid())
  userId        String
  content       String?
  type          String        @default("text") // text, image, video, carousel, poll, gif
  status        String        @default("published") // draft, scheduled, published
  thundersCount Int           @default(0)
  commentsCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  media           PostMedia[]
  comments        Comment[]
  reactions       ThunderReaction[]
  reports         Report[]
  shares          Share[]
  saves           Save[]
  views           PostView[]
  sharesCount     Int            @default(0)
  savesCount      Int            @default(0)
  viewsCount      Int            @default(0)
  watchTimeTotal  Float          @default(0.0)
  engagementScore Float          @default(0.0)
  trendingScore   Float          @default(0.0)
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String
  mediaUrl  String
  mediaType String   @default("image") // image, video
  position  Int      @default(0)
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Comment {
  id            String        @id @default(uuid())
  postId        String
  userId        String
  content       String
  parentId      String?
  thundersCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Comment?      @relation("comment_replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]     @relation("comment_replies")
  reactions     ThunderReaction[]
  reports       Report[]
}

model ThunderReaction {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  type      String   @default("THUNDER")
  createdAt DateTime @default(now())

  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model FollowRelation {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  status      String   @default("accepted") // pending, accepted
  createdAt   DateTime @default(now())

  follower    UserProfile @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   UserProfile @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Story {
  id        String   @id @default(uuid())
  userId    String
  mediaUrl  String
  mediaType String   @default("image") // image, video
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ChatRoom {
  id        String       @id @default(uuid())
  name      String?
  type      String       @default("direct") // direct, group
  createdAt DateTime     @default(now())
  
  members   ChatMember[]
  messages  Message[]
}

model ChatMember {
  id       String      @id @default(uuid())
  roomId   String
  userId   String
  role     String      @default("member") // admin, member
  joinedAt DateTime    @default(now())

  room     ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id          String      @id @default(uuid())
  roomId      String
  senderId    String
  content     String
  type        String      @default("text") // text, image, video, voice, document, gif
  isEncrypted Boolean     @default(false)
  nonce       String?
  createdAt   DateTime    @default(now())

  room        ChatRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender      UserProfile @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model DeviceKey {
  id              String      @id @default(uuid())
  userId          String
  deviceId        String
  identityKey     String
  signedPrekey    String
  prekeySignature String
  createdAt       DateTime    @default(now())

  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LiveStream {
  id          String      @id @default(uuid())
  userId      String
  title       String
  streamKey   String
  status      String      @default("live") // live, ended
  viewerCount Int         @default(0)
  startedAt   DateTime    @default(now())
  endedAt     DateTime?

  user            UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveComments    LiveComment[]
}

model LiveComment {
  id        String   @id @default(uuid())
  streamId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  stream    LiveStream  @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Community {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  avatarUrl   String?
  bannerUrl   String?
  creatorId   String
  createdAt   DateTime @default(now())

  creator     UserProfile       @relation("communityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
}

model CommunityMember {
  id          String   @id @default(uuid())
  communityId String
  userId      String
  role        String   @default("member") // moderator, member
  joinedAt    DateTime @default(now())

  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreatorChannel {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())

  user        UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contents    CreatorContent[]
}

model CreatorContent {
  id          String   @id @default(uuid())
  channelId   String
  title       String
  description String?
  mediaUrl    String
  isExclusive Boolean  @default(false)
  price       Float    @default(0.0)
  createdAt   DateTime @default(now())

  channel     CreatorChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String?
  postId         String?
  commentId      String?
  reason         String
  status         String   @default("pending") // pending, reviewed, resolved
  createdAt      DateTime @default(now())

  reporter       UserProfile  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   UserProfile? @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  post           Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment        Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrendingSearch {
  id        String   @id @default(uuid())
  query     String   @unique
  count     Int      @default(1)
  updatedAt DateTime @updatedAt
}

model UserInterest {
  id        String   @id @default(uuid())
  userId    String
  interest  String
  score     Float    @default(0.0)
  updatedAt DateTime @updatedAt

  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, interest])
}

model Share {
  id         String   @id @default(uuid())
  userId     String
  postId     String
  targetType String   @default("external") // chat, community, external, copylink
  targetId   String?
  createdAt  DateTime @default(now())

  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Save {
  id         String   @id @default(uuid())
  userId     String
  postId     String
  createdAt  DateTime @default(now())

  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostView {
  id        String   @id @default(uuid())
  userId    String?
  postId    String
  watchTime Float    @default(0.0)
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  MESSAGE
  THUNDER
  LIKE
  COMMENT
  REPLY
  FOLLOW
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  MENTION
  TAG
  SHARE
  BOOKMARK
  COMMUNITY
  EVENT
  SYSTEM
  SECURITY
  AI_RECOMMENDATION
}

enum NotificationPriority {
  HIGH
  MEDIUM
  LOW
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

model Notification {
  id             String                     @id @default(uuid())
  receiverId     String
  senderId       String
  type           NotificationType
  status         NotificationStatus         @default(UNREAD)
  priority       NotificationPriority       @default(MEDIUM)
  deliveryStatus NotificationDeliveryStatus @default(PENDING)
  groupKey       String?
  metadata       Json?                      // E.g. { "deepLink": "/post/123", "postId": "123", "actors": ["alice"] }
  deliveredAt    DateTime?
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  receiver       UserProfile                @relation("notification_recipient", fields: [receiverId], references: [id], onDelete: Cascade)
  sender         UserProfile                @relation("notification_sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId, status])
  @@index([receiverId, createdAt(sort: Desc)])
  @@index([groupKey])
  @@index([type])
  @@index([priority])
  @@index([deletedAt])
  @@map("notifications")
}

model Outbox {
  id          String    @id @default(uuid())
  aggregate   String    // "Notification"
  aggregateId String
  event       String    // "NotificationCreated"
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
  @@map("outbox")
}

model NotificationPreferences {
  userId               String      @id
  pushEnabled          Boolean     @default(true)
  emailEnabled         Boolean     @default(true)
  likesEnabled         Boolean     @default(true)
  commentsEnabled      Boolean     @default(true)
  thunderEnabled       Boolean     @default(true)
  messageEnabled       Boolean     @default(true)
  communityEnabled     Boolean     @default(true)
  recommendationEnabled Boolean    @default(true)
  marketingEnabled     Boolean     @default(true)
  quietHoursStart      String?     // E.g. "23:00"
  quietHoursEnd        String?     // E.g. "08:00"

  user                 UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("notification_preferences")
}

model NotificationAnalytics {
  id             String    @id @default(uuid())
  notificationId String
  status         String    // "created", "queued", "delivered", "opened", "clicked", "dismissed"
  timestamp      DateTime  @default(now())
  deviceType     String?   // "android", "ios", "web"

  @@index([notificationId])
  @@map("notification_analytics")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   UserProfile @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   UserProfile @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}
