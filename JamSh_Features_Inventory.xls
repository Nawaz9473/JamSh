  <Worksheet ss:Name="Overview &amp; Metadata">
    <Table>
      <Column ss:Width="150"/>
      <Column ss:Width="500"/>
      <Row ss:Height="40" ss:StyleID="Title">
        <Cell ss:MergeAcross="1"><Data ss:Type="String">JAMSH SYSTEM INVENTORY OVERVIEW</Data></Cell>
      </Row>
      <Row ss:Height="15" ss:StyleID="Default">
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
      </Row>
      <Row ss:Height="25" ss:StyleID="TabHeader">
        <Cell><Data ss:Type="String">System Attribute</Data></Cell>
        <Cell><Data ss:Type="String">Project Layout Details</Data></Cell>
      </Row>
      <Row>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Project Name</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamSh Monorepo (Hybrid E2EE Messaging &amp; Social Media Platform)</Data></Cell>
      </Row>
      <Row>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">OS Target Platforms</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Web client (Vite React Native Web) and Mobile client placeholders (Expo/Capacitor for Android &amp; iOS)</Data></Cell>
      </Row>
      <Row>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Offline Transport Layer</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Native P2P via a custom Capacitor plugin &apos;JamshNearby&apos; running Local TCP Socket servers/clients &amp; UDP beacons</Data></Cell>
      </Row>
      <Row>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Online Sync Provider</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Supabase Client &amp; Auth + PostgreSQL DB (Prisma Schema Integration)</Data></Cell>
      </Row>
      <Row>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Real-time Server Gateway</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">NestJS Gateway using Socket.io WebSocket server, backed by Redis clusters for presence monitoring</Data></Cell>
      </Row>
      <Row>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Cryptographic Standard</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">X25519 Elliptic Curve Diffie-Hellman Key Exchange (E2EE Pairwise) + AES-GCM (Authenticated Encrypted Envelopes)</Data></Cell>
      </Row>
      <Row>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Authentication Support</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Email/Password signups, Google OAuth, Phone SMS OTP, and reset recovery hooks</Data></Cell>
      </Row>
      <Row>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Monorepo Workspace Layout</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">• apps/web: Core frontend React Native Web client
• apps/mobile: Expo hybrid mobile placeholder
• apps/api-server: NestJS API server
• apps/testing-e2e: Playwright testing harness
• packages/api: Client API SDK
• packages/encryption: Shared cryptographic methods
• packages/shared: Data validations &amp; filters
• packages/types: Common Typescript definitions
• packages/ui: Design theme constants</Data></Cell>
      </Row>
      <Row>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Compilation &amp; Setup Commands</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">• Install: npm install
• Build: npm run build
• Dev Web Client: npm run dev --workspace @jamsh/web
• Capacitor Sync: npm run cap:sync
• Run Playwright Tests: npx playwright test</Data></Cell>
      </Row>
    </Table>
  </Worksheet>
  <Worksheet ss:Name="P2P &amp; Cryptography">
    <Table>
      <Column ss:Width="60"/>
      <Column ss:Width="100"/>
      <Column ss:Width="160"/>
      <Column ss:Width="140"/>
      <Column ss:Width="440"/>
      <Column ss:Width="220"/>
      <Row ss:Height="35" ss:StyleID="Title">
        <Cell ss:MergeAcross="5"><Data ss:Type="String">P2P &amp; CRYPTOGRAPHY FEATURES LEDGER</Data></Cell>
      </Row>
      <Row ss:Height="10" ss:StyleID="Default">
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
      </Row>
      <Row ss:Height="25" ss:StyleID="Default">
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">ID</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Module</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Feature Name</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Status</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Working Mechanism &amp; Security Controls</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Primary Code Reference</Data></Cell>
      </Row>
      <Row ss:Height="25" ss:StyleID="Default">
        <Cell ss:StyleID="SectionHeader" ss:MergeAcross="5"><Data ss:Type="String">1. Capacitor Native Offline Transport Layer</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">P2P-01</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Nearby Transport</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Local TCP Server</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Listens for direct socket communication over local Wi-Fi/Hotspot networks on port 8383 inside Android (Java) and iOS (Swift) Plugins. Emits &apos;messageReceived&apos; events carrying encrypted envelopes to the frontend.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L317-365
JamshNearbyPlugin.swift:L217-243</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">P2P-02</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Nearby Transport</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Local TCP Client</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Initiates socket connections to recipient peer&apos;s IP address on port 8383 to transmit encrypted envelope packets and read validated cryptographic ACK signals.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L451-489
JamshNearbyPlugin.swift:L354-411</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">P2P-03</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Nearby Transport</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">UDP Beacon Advertising</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Broadcasts a list of up to 5 rotating contact pseudonymous tokens derived via HMAC-SHA256 on port 8384 every 3 seconds to advertise local device presence.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L190-226
JamshNearbyPlugin.swift:L109-158</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">P2P-04</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Nearby Transport</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">UDP Beacon Scanning</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Listens to UDP port 8384, decodes presence strings, identifies peer IP addresses, and alerts WebView via &apos;peerDiscovered&apos; events. Requests Android MulticastLock to bypass system-level packet drops.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L243-310
JamshNearbyPlugin.swift:L160-201</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">P2P-05</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Nearby Transport</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Length-Prefixed Framing</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Encodes network packets in a &apos;[4-byte big-endian length-prefix][JSON payload]&apos; frame. Sockets evaluate size (max 1MB) before allocating memory buffers to block resource exhaustion bugs.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L490-532
JamshNearbyPlugin.swift:L413-457</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">P2P-06</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Nearby Transport</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Connection Rate Limits</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Limits active pending server sockets to a global maximum of 10 concurrent connections, and throttling per-source IP to 2 concurrent sockets to protect against Local Denial of Service.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L370-386
JamshNearbyPlugin.swift:L255-284</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">P2P-07</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Nearby Transport</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Background Auto-Eviction TTL</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Registers an auto-eviction timer on socket creation. Closes connections automatically after 15 seconds if no ACK/NACK has been written, preventing server thread lockups.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L397-405
JamshNearbyPlugin.swift:L305-311</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">P2P-08</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Nearby Transport</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Atomic Response Close</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Removes connection socket atomically from the active map and closes it under all execution paths once respondToEnvelope is called to prevent multi-response replay conditions.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L430-447
JamshNearbyPlugin.swift:L328-351</Data></Cell>
      </Row>
      <Row ss:Height="25" ss:StyleID="Default">
        <Cell ss:StyleID="SectionHeader" ss:MergeAcross="5"><Data ss:Type="String">2. Cryptographic Security &amp; E2E Encrypted Controls</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">CRY-01</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Cryptography</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Pairwise E2EE Logic</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Derives pairwise shared secret keys between sender and recipient device keys using Diffie-Hellman (X25519). Encrypts the JSON envelope plaintext using authenticated AES-GCM encryption with unique nonces.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">packages/encryption/src/index.ts
packages/api/src/index.ts:L1578-1591</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">CRY-02</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Cryptography</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Secure Hardware Keystore</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Encrypts user key pairs using Android KeyStore provider with AES/GCM/NoPadding, storing encrypted blobs in SharedPreferences. iOS handles keys directly inside Apple Keychain.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L81-184
JamshNearbyPlugin.swift:L35-103</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">CRY-03</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Cryptography</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Key Migration Ledger</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Detects legacy E2EE keypairs in LocalStorage on native app startup. Migrates them atomically to the hardware-backed keystore/keychain, verifies consistency, and purges the unsecure copies.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">packages/api/src/index.ts:L1901-1920</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">CRY-04</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Cryptography</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">HMAC Rotating Beacons</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Protects UDP broadcast privacy by calculating 16-character beacon tokens via HMAC-SHA256(SharedSecret, Epoch), refreshing every 15 minutes. Scanners compute the same to recognize peer identities.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">packages/api/src/index.ts:L1057-1088
packages/api/src/index.ts:L1127-1142</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">CRY-05</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Cryptography</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Beacon Correlation Throttling</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Batches rotating contact beacons in groups of 5 per UDP packet. Rotates batches every 30 seconds to bypass standard 512-byte MTU caps and prevent observers from linking multiple tokens to a single device.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">packages/api/src/index.ts:L1071-1091</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">CRY-06</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Cryptography</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Sender Cryptographic Binding</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Rejects incoming offline messages if the sender&apos;s public key is not cached from a previous online synchronization (prevents first-time chat spoofing offline). Decryption success confirms authenticity.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">packages/api/src/index.ts:L1251-1288</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">CRY-07</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Cryptography</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Purpose-Separated ACKs</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Recipients derive an ACK-specific key via HMAC-SHA256(SharedSecret, &apos;jamsh-ack-key&apos;). Signs a canonical context string: &apos;v1|length(msgId):msgId|SUCCESS|length(userId):userId&apos; to prevent cross-protocol replays.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">packages/api/src/index.ts:L1318-1340
packages/api/src/index.ts:L1645-1669</Data></Cell>
      </Row>
    </Table>
  </Worksheet>
  <Worksheet ss:Name="Sync &amp; Chat Gateway">
    <Table>
      <Column ss:Width="60"/>
      <Column ss:Width="100"/>
      <Column ss:Width="160"/>
      <Column ss:Width="140"/>
      <Column ss:Width="440"/>
      <Column ss:Width="220"/>
      <Row ss:Height="35" ss:StyleID="Title">
        <Cell ss:MergeAcross="5"><Data ss:Type="String">SYNC &amp; CHAT GATEWAY FEATURES LEDGER</Data></Cell>
      </Row>
      <Row ss:Height="10" ss:StyleID="Default">
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
        <Cell><Data ss:Type="String"></Data></Cell>
      </Row>
      <Row ss:Height="25" ss:StyleID="Default">
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">ID</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Module</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Feature Name</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Status</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Working Mechanism &amp; Sync Controls</Data></Cell>
        <Cell ss:StyleID="ColHeader"><Data ss:Type="String">Primary Code Reference</Data></Cell>
      </Row>
      <Row ss:Height="25" ss:StyleID="Default">
        <Cell ss:StyleID="SectionHeader" ss:MergeAcross="5"><Data ss:Type="String">1. SQLite Local Offline Message Queue</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">OFL-01</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Queue Service</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Local SQLite Queue</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Native Integration</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Manages unsent message envelopes locally in native SQLite database (jamsh_offline_queue.db) using tables mapping message_id, room_id, recipient_id, and serialized envelope JSON payloads.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L659-720
JamshNearbyPlugin.swift:L462-566</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">OFL-02</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Queue Service</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Web Fallback Storage</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Provides transparent fallback to LocalStorage queue arrays if the application is running in a standard web browser instead of a native Android or iOS application.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">packages/api/src/index.ts:L981-1030</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">OFL-03</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Queue Service</Data></Cell>
