        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">JamshNearbyPlugin.java:L608-638
JamshNearbyPlugin.swift:L580-589</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">OFL-04</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Queue Service</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Idempotent Queue Sync</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Iterates through SQLite database entries upon online transition. POSTs envelopes to the remote Supabase API. Deletes successfully uploaded envelopes from the local database.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">packages/api/src/index.ts:L1172-1219</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">OFL-05</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Queue Service</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Duplicate Sync Reconciliation</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">If a peer synchronizes the message online first, the server returns a duplicate key conflict (PostgreSQL code 23505). The local sync logic resolves this conflict by deleting the item from the queue.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">packages/api/src/index.ts:L1203-1209</Data></Cell>
      </Row>
      <Row ss:Height="25" ss:StyleID="Default">
        <Cell ss:StyleID="SectionHeader" ss:MergeAcross="5"><Data ss:Type="String">2. WebSocket Real-Time Chat &amp; Signalling</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">WSG-01</Data></Cell>
