        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">NestJS WebSocket gateway handling real-time peer communication via Socket.io. Configured with CORS allowance and query handshake filters.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">chat.gateway.ts:L15-28</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">WSG-02</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Chat Gateway</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Presence &amp; Redis Sync</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Tracks connected socket IDs in memory. Updates Redis statuses (&apos;online&apos; / &apos;offline&apos;) and broadcasts updates (&apos;user_status&apos;) to all active socket clients.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">chat.gateway.ts:L29-54</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">WSG-03</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Chat Gateway</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Real-Time Message Relay</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Relays E2EE message payloads instantly to online recipients and transmits socket delivery receipts (&apos;message_delivered&apos;) back to the sender.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">chat.gateway.ts:L56-78</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">WSG-04</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Chat Gateway</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">Typing Status Indicators</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Broadcasts typing statuses (&apos;typing_status&apos;) between active room members to display visual markers on the UI.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">chat.gateway.ts:L80-88</Data></Cell>
      </Row>
      <Row ss:Height="55" ss:StyleID="Default">
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">WSG-05</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Chat Gateway</Data></Cell>
        <Cell ss:StyleID="CellBold"><Data ss:Type="String">WebRTC Signalling Bridge</Data></Cell>
        <Cell ss:StyleID="StatusLive"><Data ss:Type="String">Fully Working</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">Exposes events (call_dial, call_sdp_offer, call_sdp_answer, call_ice_candidate, call_hangup) to relay WebRTC messages between dialing peers, establishing direct P2P media tunnels.</Data></Cell>
        <Cell ss:StyleID="CellNormal"><Data ss:Type="String">chat.gateway.ts:L90-137</Data></Cell>
      </Row>
